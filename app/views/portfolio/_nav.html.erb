<style>
  .portfolio-mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    border-radius: 8px;
    padding: 4px;
    transition: background 0.2s;
  }
  .portfolio-mobile-menu-btn span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--muted, #6a5e4e);
    border-radius: 1px;
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    transform-origin: center;
    pointer-events: none;
  }
  .portfolio-mobile-menu-btn.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); background: var(--gold, #b8862e); }
  .portfolio-mobile-menu-btn.open span:nth-child(2) { transform: scaleX(0); opacity: 0; }
  .portfolio-mobile-menu-btn.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); background: var(--gold, #b8862e); }

  @media (max-width: 768px) {
    .portfolio-mobile-menu-btn { display: flex; }
    .nav-links {
      display: none !important;
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 200;
      background: rgba(10,9,7,0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border2, #2a2520);
      flex-direction: column !important;
      padding: 4rem 1.5rem 2rem !important;
      gap: 0.25rem !important;
      align-items: stretch !important;
      transform: translateY(-110%);
      transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    }
    .nav-links.mobile-open {
      display: flex !important;
      transform: translateY(0) !important;
    }
    .nav-links a {
      padding: 0.875rem 1rem !important;
      min-height: 44px !important;
      display: flex !important;
      align-items: center !important;
      border-radius: 8px;
      font-size: 0.72rem !important;
      letter-spacing: 0.12em !important;
    }
    .nav-links a:hover { background: rgba(184,134,46,0.08); }
    .mode-slider {
      width: 100% !important;
      justify-content: space-around;
      margin-top: 0.5rem;
    }
    .tag-search-wrap { width: 100%; }
    .tag-search-input-wrap { width: 100%; }
    .tag-search-input { width: 100% !important; flex: 1; }
    .tag-search-dropdown { width: 100%; }
  }
</style>
<nav id="main-nav">
  <span class="nav-name"><%= @user.display_name %></span>
  <button class="portfolio-mobile-menu-btn" id="portfolio-menu-btn" onclick="togglePortfolioMenu()" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <div class="nav-links" id="portfolio-nav-links">
    <a href="#works">Works</a>
    <% if @user.artist_statement.present? %>
      <a href="#about">About</a>
    <% end %>

    <% if @all_tags&.any? %>
      <div class="tag-search-wrap" id="tagSearchWrap">
        <div class="tag-search-input-wrap">
          <span class="tag-search-hash">#</span>
          <input
            type="text"
            id="tagSearchInput"
            class="tag-search-input"
            placeholder="search tags…"
            autocomplete="off"
            value="<%= params[:tag] %>"
          >
          <% if params[:tag].present? %>
            <a href="<%= portfolio_path(status: params[:status]) %>" class="tag-search-clear" title="Clear tag filter">×</a>
          <% end %>
        </div>
        <div class="tag-search-dropdown" id="tagSearchDropdown">
          <% @all_tags.each do |tag| %>
            <a href="<%= portfolio_path(tag: tag.name, status: params[:status]) %>" class="tag-search-option" data-tag="<%= tag.name %>">
              <span class="tag-search-option-hash">#</span><%= tag.name %>
            </a>
          <% end %>
          <div class="tag-search-empty" id="tagSearchEmpty" style="display:none;">No matching tags</div>
        </div>
      </div>
    <% end %>

    <a
      href="#"
      onclick="sharePortfolio(event)"
      class="nav-contact"
      id="share-btn"
      data-share-url="<%= public_portfolio_url(@user.user_hash) %>"
    >Share</a>
    <% if @user.contact_email.present? %>
      <a href="<%= public_enquiry_path(@user.user_hash) %>" class="nav-contact">Enquire</a>
    <% end %>
    <div class="mode-slider" id="mode-slider">
      <button class="mode-btn" data-mode="classic" onclick="setMode('classic')">Classic</button>
      <button class="mode-btn" data-mode="raw" onclick="setMode('raw')">Studio</button>
      <button class="mode-btn" data-mode="creative" onclick="setMode('creative')">Reel</button>
      <div class="slider-pill" id="slider-pill"></div>
    </div>
  </div>
</nav>

<script>
  // ── PORTFOLIO MOBILE MENU ──
  function togglePortfolioMenu() {
    var links = document.getElementById('portfolio-nav-links');
    var btn = document.getElementById('portfolio-menu-btn');
    var isOpen = links.classList.toggle('mobile-open');
    btn.classList.toggle('open', isOpen);
    btn.setAttribute('aria-expanded', isOpen);
  }
  // Close menu on link click
  document.addEventListener('click', function(e) {
    var links = document.getElementById('portfolio-nav-links');
    var btn = document.getElementById('portfolio-menu-btn');
    if (links && btn && links.classList.contains('mobile-open')) {
      if (!links.contains(e.target) && !btn.contains(e.target)) {
        links.classList.remove('mobile-open');
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    }
  });

  function sharePortfolio(e) {
    e.preventDefault();
    const btn = document.getElementById('share-btn');
    const url = btn.dataset.shareUrl;
    const title = document.title;

    if (navigator.share) {
      navigator.share({ title: title, url: url }).catch(console.error);
    } else {
      navigator.clipboard.writeText(url).then(() => {
        const original = btn.innerText;
        btn.innerText = 'Copied!';
        setTimeout(() => { btn.innerText = original; }, 2000);
      }).catch(() => {
        alert("Share this link:\n" + url);
      });
    }
  }
</script>