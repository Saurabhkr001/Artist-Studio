  credits = [
    {
      role: "Utpatti-Karta",
      name: "Saurabh Kumar",
      lines: [
        "Log mujhse pyar se 'Prabhu' bulate hain",
        "Tumne meri murti dekhi hogi, Mandiron me."
      ],
      links: [
        { label: "github",   url: "https://github.com/Saurabhkr001" },
        { label: "linkedin", url: "https://www.linkedin.com/in/saurabh-kumar-401b42212/" },
        { label: "instagram",  url: "https://instagram.com/saurabh_kr001"}
      ]
    },
    {
      role: "for",
      name: "Every Artist Who Uses This",
      lines: [
