    { key: "auth",       value: "Devise",                       note: "Session management · secure sign-in/out flows" },
    { key: "storage",    value: "Active Storage",               note: "Artwork uploads · avatar management · variant processing" },
    { key: "database",   value: "PostgreSQL",                   note: "Relational data · full-text search · production-ready" },
