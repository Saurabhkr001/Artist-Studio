%>

<style>
  .credits-page {
    --canvas2:   #141109;
    --canvas3:   #1a1612;
    --ochre:     #c4933f;
    --ochre-dim: #8a6628;
    --cream:     #f0e6d3;
    --cream-dim: #a89070;
    --stone:     #5a5040;
    --rule:      #231f18;
    --green:     #7fae72;
    --red:       #b06a5f;
    font-family: 'DM Mono', monospace;
  }

  .credits-page .wrap { max-width: 720px; margin: 0 auto; padding: 6vh 0 8vh; }

  .credits-page .fade {
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .credits-page .fade.visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .credits-page .fade { opacity: 1; transform: none; transition: none; }
  }

  .credits-page .hero { text-align: center; margin-bottom: 4rem; }
  .credits-page .rule-v {
    width: 1px; height: 56px;
    background: linear-gradient(to bottom, transparent, var(--ochre-dim), transparent);
    margin: 0 auto 3.5rem;
  }
  .credits-page .hero-eyebrow {
    font-size: 0.55rem; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--ochre-dim); margin-bottom: 2rem;
  }
  .credits-page .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 700; color: var(--ochre);
    line-height: 1; letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 0 30px rgba(196, 147, 63, 0.6), 0 0 60px rgba(196, 147, 63, 0.4);
    animation: god-pulse 4s infinite alternate;
  }

  @keyframes god-pulse {
    0% { 
      text-shadow: 0 0 30px rgba(196, 147, 63, 0.6), 0 0 60px rgba(196, 147, 63, 0.4); 
      transform: scale(1); 
    }
    100% { 
      text-shadow: 0 0 50px rgba(196, 147, 63, 0.9), 0 0 80px rgba(196, 147, 63, 0.6), 0 0 100px rgba(196, 147, 63, 0.4); 
      transform: scale(1.02); 
    }
  }
  .credits-page .hero-meta {
    margin-top: 1.5rem; font-size: 0.6rem; letter-spacing: 0.2em; color: var(--stone);
  }
  .credits-page .hero-meta span { color: var(--ochre-dim); margin: 0 0.6rem; }

  /* ── Terminal window ── */
  .credits-page .terminal-shell {
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--canvas2);
    box-shadow: 0 20px 60px rgba(0,0,0,0.45);
    overflow: hidden;
    position: relative;
  }
  .credits-page .terminal-shell::after {
    content: '';
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      to bottom, rgba(255,255,255,0.012) 0px, rgba(255,255,255,0.012) 1px,
      transparent 1px, transparent 3px
    );
    pointer-events: none;
  }

  .credits-page .terminal-titlebar {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: var(--canvas3);
    border-bottom: 1px solid var(--rule);
  }
  .credits-page .terminal-dots { display: flex; gap: 6px; }
  .credits-page .terminal-dots span {
    width: 9px; height: 9px; border-radius: 50%; display: block;
  }
  .credits-page .terminal-dots span:nth-child(1) { background: #a85a52; }
  .credits-page .terminal-dots span:nth-child(2) { background: var(--ochre); }
  .credits-page .terminal-dots span:nth-child(3) { background: #6f9962; }

  .credits-page .terminal-filename {
    font-size: 0.62rem; letter-spacing: 0.05em; color: var(--stone);
    flex: 1; text-align: center;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .credits-page .terminal-skip {
    font-size: 0.55rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--stone); background: none; border: 1px solid var(--rule);
    border-radius: 4px; padding: 0.25rem 0.5rem; cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease; flex-shrink: 0;
  }
  .credits-page .terminal-skip:hover { color: var(--ochre); border-color: var(--ochre-dim); }

  .credits-page .terminal-body {
    padding: 1.25rem 1.25rem 0.5rem;
    max-height: 60vh;
    overflow-y: auto;
    font-size: 0.72rem;
    line-height: 1.7;
    position: relative;
  }

  .credits-page .term-line { white-space: pre-wrap; word-break: break-word; }
  .credits-page .term-line.cmd { color: var(--cream); }
  .credits-page .term-line.cmd::before { content: '$ '; color: var(--ochre-dim); }
  .credits-page .term-line.out { color: var(--cream-dim); }
  .credits-page .term-line.dim { color: var(--stone); }
  .credits-page .term-line.accent { color: var(--ochre); }
  .credits-page .term-line.ok { color: var(--green); }
  .credits-page .term-line.err { color: var(--red); }
  .credits-page .term-line.heading { color: var(--cream); margin-top: 0.5rem; }
  .credits-page .term-line.spacer { height: 0.5rem; }

  .credits-page .term-key { color: var(--ochre-dim); }
  .credits-page .term-link { color: var(--ochre); text-decoration: none; border-bottom: 1px solid var(--ochre-dim); }
  .credits-page .term-link:hover { color: var(--cream); border-color: var(--cream); }

  .credits-page .terminal-input-row {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.85rem 1.25rem 1rem;
    border-top: 1px solid var(--rule);
  }
  .credits-page .terminal-prompt { color: var(--ochre-dim); font-size: 0.72rem; flex-shrink: 0; }
  .credits-page .terminal-input {
    flex: 1; background: none; border: none; outline: none;
    color: var(--cream); font-family: 'DM Mono', monospace; font-size: 0.72rem;
    caret-color: var(--ochre); min-width: 0;
  }
  .credits-page .terminal-input::placeholder { color: var(--stone); }

  .credits-page .terminal-suggestions {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    padding: 0 1.25rem 1.1rem;
  }
  .credits-page .term-chip {
    font-size: 0.58rem; letter-spacing: 0.08em;
    color: var(--stone); background: var(--canvas3);
    border: 1px solid var(--rule); border-radius: 4px;
    padding: 0.3rem 0.6rem; cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .credits-page .term-chip:hover { color: var(--ochre); border-color: var(--ochre-dim); }

  .credits-page .note-hint {
    text-align: center; font-size: 0.55rem; letter-spacing: 0.15em;
    text-transform: uppercase; color: var(--stone); margin-top: 1.5rem;
  }

  .credits-page .page-footer { text-align: center; padding-top: 3rem; }
  .credits-page .page-footer-text {
    font-size: 0.55rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--stone);
  }
  .credits-page .page-footer-text span { color: var(--ochre-dim); margin: 0 0.5rem; }

  /* ── Live preview window (Expanded Beyond 720px Parent Constraints) ── */
  .credits-page .browser-frame {
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--canvas2);
    box-shadow: 0 20px 60px rgba(0,0,0,0.45);
    overflow: hidden;
    margin-top: 4rem;
    
    /* Dynamically break out of the 720px wrapper up to 1200px desktop size */
    width: min(94vw, 1200px);
    margin-left: calc(50% - min(94vw, 1200px) / 2);
    position: relative;
  }

  .credits-page .browser-titlebar {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: var(--canvas3);
    border-bottom: 1px solid var(--rule);
  }

  .credits-page .browser-dots { display: flex; gap: 6px; flex-shrink: 0; }
  .credits-page .browser-dots span {
    width: 9px; height: 9px; border-radius: 50%; display: block;
  }
  .credits-page .browser-dots span:nth-child(1) { background: #a85a52; }
  .credits-page .browser-dots span:nth-child(2) { background: var(--ochre); }
  .credits-page .browser-dots span:nth-child(3) { background: #6f9962; }

  .credits-page .browser-url-bar {
    flex: 1;
    display: flex; align-items: center; gap: 0.5rem;
    background: var(--canvas2);
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 0.3rem 0.7rem;
    font-size: 0.62rem;
    color: var(--stone);
    overflow: hidden;
  }
  .credits-page .browser-url-bar .lock { color: var(--green); flex-shrink: 0; }
  .credits-page .browser-url-bar .url-text {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cream-dim);
  }

  .credits-page .browser-open-link {
    font-size: 0.55rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--stone); background: none; border: 1px solid var(--rule);
    border-radius: 4px; padding: 0.25rem 0.5rem; cursor: pointer; flex-shrink: 0;
    text-decoration: none; transition: color 0.2s ease, border-color 0.2s ease;
  }
  .credits-page .browser-open-link:hover { color: var(--ochre); border-color: var(--ochre-dim); }

  .credits-page .browser-frame-body {
    position: relative;
    width: 100%;
    height: 75vh;
    min-height: 580px;
    background: var(--canvas3);
  }

  .credits-page .browser-frame-body iframe {
    width: 100%; height: 100%; border: none; display: block;
    background: var(--canvas3);
  }

  .credits-page .browser-loading,
  .credits-page .browser-fallback {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.75rem; text-align: center; padding: 1.5rem;
    font-size: 0.65rem; color: var(--stone);
    background: var(--canvas3);
  }
  .credits-page .browser-fallback { display: none; }
  .credits-page .browser-fallback a {
    color: var(--ochre); text-decoration: none; border-bottom: 1px solid var(--ochre-dim);
    font-size: 0.62rem;
  }
  .credits-page .browser-fallback a:hover { color: var(--cream); border-color: var(--cream); }

  .credits-page .browser-live-label {
    text-align: center; font-size: 0.55rem; letter-spacing: 0.15em;
    text-transform: uppercase; color: var(--stone); margin-top: 1rem;
  }

  /* ── No-JS static fallback ── */
  .credits-page .noscript-credits .credit-row {
    display: grid; grid-template-columns: 140px 1fr;
    border-top: 1px solid var(--rule); padding: 1.5rem 0;
  }
  .credits-page .noscript-credits .credit-row:last-child { border-bottom: 1px solid var(--rule); }
  .credits-page .noscript-credits .credit-role {
    font-size: 0.55rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--stone);
  }
  .credits-page .noscript-credits .credit-name {
    font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; color: var(--cream); margin-bottom: 0.3rem;
  }
  .credits-page .noscript-credits .credit-detail { font-size: 0.65rem; color: var(--cream-dim); line-height: 1.7; }
  .credits-page .noscript-credits .label {
    display: block; font-size: 0.55rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--stone); margin: 2.5rem 0 1rem;
  }

  @media (max-width: 480px) {
    .credits-page .terminal-body { font-size: 0.68rem; max-height: 55vh; }
    .credits-page .terminal-filename { display: none; }
    .credits-page .noscript-credits .credit-row { grid-template-columns: 1fr; }
    .credits-page .browser-frame-body { height: 60vh; min-height: 400px; }
    .credits-page .browser-url-bar .url-text { max-width: 140px; }
  }

  /* ── ASCII photo preview ── */
  .credits-page .ascii-photo {
    font-size: 5px;
    line-height: 5px;
    letter-spacing: 0;
    background: var(--canvas3);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 10px;
    display: inline-block;
    white-space: pre;
    font-family: 'DM Mono', monospace;
    max-width: 100%;
    overflow: hidden;
  }

  /* ── Developed photo reveal ── */
  .credits-page .photo-frame {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 8px;
    background: var(--canvas3);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
  .credits-page .photo-frame img {
    display: block;
    width: 190px;
    height: auto;
    border-radius: 2px;
    filter: sepia(0.18) contrast(1.05) saturate(0.9);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.15s cubic-bezier(0.65,0,0.35,1);
  }
  .credits-page .photo-frame img.revealed { clip-path: inset(0 0 0 0); }
  .credits-page .photo-caption {
    font-size: 0.55rem; letter-spacing: 0.1em; color: var(--stone);
    margin-top: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .credits-page .photo-frame img { clip-path: inset(0 0 0 0); transition: none; }
  }
</style>

<div class="credits-page">
  <div class="wrap">

    <!-- HERO -->
    <div class="fade visible hero">
      <div class="rule-v"></div>
      <%# <p class="hero-eyebrow">A commemorative project<span style="margin:0 1rem;color:#5f4d3fff;">·</span>Built with intent</p> %>
      <h1 class="hero-title">BHAGWAN</h1>
      <p class="hero-meta">
        Edition No. 1 <span>·</span> <%= Date.today.year %> <span>·</span> v1.0.0
      </p>
    </div>

    <!-- LIVE PREVIEW WINDOW -->
    <div class="fade visible browser-frame" id="live-preview-window">
      <div class="browser-titlebar">
        <div class="browser-dots"><span></span><span></span><span></span></div>
        <div class="browser-url-bar">
          <span class="lock">🔒</span>
          <span class="url-text">saurabhkr001.github.io/saurabh-portfolio/</span>
        </div>
        <a class="browser-open-link" href="https://saurabhkr001.github.io/saurabh-portfolio/" target="_blank" rel="noopener">open ↗</a>
      </div>
      <div class="browser-frame-body">
        <div class="browser-loading" id="live-preview-loading">loading live site…</div>
        <div class="browser-fallback" id="live-preview-fallback">
          <p>this browser is blocking the embedded preview.</p>
          <a href="https://saurabhkr001.github.io/saurabh-portfolio/" target="_blank" rel="noopener">open the live portfolio in a new tab →</a>
        </div>
        <iframe
          id="live-preview-iframe"
          src="https://saurabhkr001.github.io/saurabh-portfolio/"
          title="Saurabh Kumar — Live Portfolio"
          referrerpolicy="no-referrer-when-downgrade"
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
          onload="this.dataset.loaded='true'" 
        ></iframe>
      </div>
    </div>
    <p class="browser-live-label">live · fully interactive</p>

    <p class="note-hint">no keyboard handy? tap a command above</p>

    <!-- TERMINAL -->
    <div class="fade visible terminal-shell" id="credits-terminal" aria-label="Interactive credits terminal">
      <div class="terminal-titlebar">
        <div class="terminal-dots"><span></span><span></span><span></span></div>
        <span class="terminal-filename">saurabh@the-studio: ~/credits</span>
        <button type="button" class="terminal-skip" id="terminal-skip">skip intro</button>
      </div>

      <div class="terminal-body" id="terminal-body" role="log" aria-live="polite"></div>

      <div class="terminal-input-row">
        <label class="terminal-prompt" for="terminal-input">visitor@the-studio:~$</label>
        <input
          type="text"
          id="terminal-input"
          class="terminal-input"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="type help ↵"
        >
      </div>

      <div class="terminal-suggestions" id="terminal-suggestions">
        <% %w[help whoami photo credits stack log thanks fortune coffee stats art clear].each do |cmd| %>
          <button type="button" class="term-chip" data-command="<%= cmd %>"><%= cmd %></button>
        <% end %>
      </div>
    </div>

    <!-- Fallback data framework for JS-disabled clients and indices -->
    <noscript>
      <div class="noscript-credits" style="margin-top: 3rem;">
        <img src="/images/credits-avatar.jpg" alt="Photo of Saurabh Kumar"
             style="width:160px;border-radius:4px;border:1px solid #231f18;display:block;margin-bottom:2rem;">
        <span class="label">Project Credits</span>
        <% credits.each do |c| %>
          <div class="credit-row">
            <span class="credit-role"><%= c[:role] %></span>
            <div>
              <p class="credit-name"><%= c[:name] %></p>
              <p class="credit-detail">
                <%= safe_join(c[:lines], tag.br) %>
                <% c[:links].each do |l| %>
                  <br><%= link_to l[:label], l[:url], target: "_blank", rel: "noopener" %>
                <% end %>
              </p>
            </div>
          </div>
        <% end %>

        <span class="label">Technical Specifications</span>
        <% stack.each do |s| %>
          <div class="credit-row">
            <span class="credit-role"><%= s[:key] %></span>
            <div>
              <p class="credit-name"><%= s[:value] %></p>
              <p class="credit-detail"><%= s[:note] %></p>
            </div>
          </div>
        <% end %>

        <span class="label">Special Thanks</span>
        <% thanks.each do |t| %>
          <div class="credit-row">
            <span class="credit-role"><%= t[:role] %></span>
            <div>
              <p class="credit-name"><%= t[:name] %></p>
              <p class="credit-detail"><%= safe_join(t[:lines], tag.br) %></p>
            </div>
          </div>
        <% end %>

        <span class="label">A Note</span>
        <p class="credit-detail"><%= safe_join(note_lines, tag.br) %></p>
      </div>
    </noscript>

    <div class="page-footer fade visible">
      <p class="page-footer-text">
        © <%= Date.today.year %> The Studio <span>·</span> Saurabh Kumar <span>·</span> Fin.
      </p>
    </div>

  </div>
</div>

<script type="application/json" id="credits-data"><%= raw(terminal_payload.to_json) %></script>

<script>
(function () {
  var DATA = JSON.parse(document.getElementById('credits-data').textContent);
  var body = document.getElementById('terminal-body');
  var input = document.getElementById('terminal-input');
  var skipBtn = document.getElementById('terminal-skip');
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var PHOTO_URL = '/images/credits-avatar.jpg';
  var photoImagePromise = null;

  var skipRequested = reduceMotion;
  var queue = Promise.resolve();
  var cmdHistory = [];
  var historyPos = -1;
  var ALL_COMMANDS = [
    'help', 'whoami', 'photo', 'develop', 'credits', 'stack', 'log', 'thanks',
    'note', 'fortune', 'coffee', 'stats', 'history', 'art', 'matrix', 'ls', 'clear'
  ];

  function lerp(a, b, t) { return a + (b - a) * t; }

  function scrollDown() { body.scrollTop = body.scrollHeight; }

  function appendLine(text, cls) {
    var el = document.createElement('div');
    el.className = 'term-line ' + (cls || 'out');
    el.textContent = text;
    body.appendChild(el);
    scrollDown();
    return el;
  }

  function appendHTML(html, cls) {
    var el = document.createElement('div');
    el.className = 'term-line ' + (cls || 'out');
    el.innerHTML = html;
    body.appendChild(el);
    scrollDown();
    return el;
  }

  function appendSpacer() {
    var el = document.createElement('div');
    el.className = 'term-line spacer';
    body.appendChild(el);
  }

  function typeLine(text, cls) {
    return new Promise(function (resolve) {
      if (skipRequested) { resolve(appendLine(text, cls)); return; }
      var el = document.createElement('div');
      el.className = 'term-line ' + (cls || 'out');
      body.appendChild(el);
      var i = 0;
      var iv = setInterval(function () {
        if (skipRequested) {
          clearInterval(iv);
          el.textContent = text;
          scrollDown();
          resolve(el);
          return;
        }
        el.textContent += text.charAt(i);
        i++;
        scrollDown();
        if (i >= text.length) { clearInterval(iv); resolve(el); }
      }, 12);
    });
  }

  function queueTyped(text, cls) {
    queue = queue.then(function () { return typeLine(text, cls); });
  }

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  document.querySelectorAll('.term-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      var cmd = chip.getAttribute('data-command');
      queue = queue.then(function () { return runCommand(cmd); });
      input.focus({ preventScroll: true });
    });
  });

  document.getElementById('credits-terminal').addEventListener('click', function (e) {
    if (e.target === input) return;
    input.focus({ preventScroll: true });
  });

  // Base terminal commands mapping
  function renderCredits() {
    appendLine('cat credits.txt', 'heading');
    DATA.credits.forEach(function (c) {
      appendHTML('<span class="term-key">[' + esc(c.role) + ']</span> ' + esc(c.name), 'accent');
      c.lines.forEach(function (l) { appendLine('  ' + l, 'out'); });
      c.links.forEach(function (l) {
        appendHTML('  → <a class="term-link" href="' + esc(l.url) + '" target="_blank" rel="noopener">' + esc(l.label) + '</a>', 'out');
      });
      appendSpacer();
    });
  }

  function renderStack() {
    appendLine('cat stack.json', 'heading');
    appendLine('{', 'out');
    DATA.stack.forEach(function (s, i) {
      var comma = i < DATA.stack.length - 1 ? ',' : '';
      appendHTML('  <span class="term-key">"' + esc(s.key) + '"</span>: "' + esc(s.value) + '"' + comma + '  <span style="color:var(--stone)">// ' + esc(s.note) + '</span>', 'out');
    });
    appendLine('}', 'out');
    appendSpacer();
  }

  function renderLog() {
    appendLine('git log --oneline -5', 'heading');
    DATA.commits.forEach(function (c) {
      appendHTML('<span class="term-key">' + esc(c.hash) + '</span>  ' + esc(c.msg), 'out');
    });
    appendSpacer();
  }

  function renderThanks() {
    appendLine('cat thanks.txt', 'heading');
    DATA.thanks.forEach(function (t) {
      appendHTML('<span class="term-key">[' + esc(t.role) + ']</span> ' + esc(t.name), 'accent');
      t.lines.forEach(function (l) { appendLine('  ' + l, 'out'); });
      appendSpacer();
    });
  }

  function renderNote() {
    appendLine('cat note.txt', 'heading');
    DATA.note.forEach(function (l) { appendLine(l === '' ? ' ' : l, 'out'); });
    appendSpacer();
  }

  function renderArt() {
    var art = [
      '    ┌───────────────┐',
      '    │  > _          │',
      '    │               │',
      '    └─┬───────┬─┘',
      '        │       │',
      '    ────┴───────┴────'
    ];
    art.forEach(function (l) { appendLine(l, 'dim'); });
    appendSpacer();
  }

  function renderHelp() {
    appendLine('available commands:', 'heading');
    [
      ['whoami',   'who built this'],
      ['photo',    'load and preview my photo'],
      ['develop', 'reveal it at full resolution'],
      ['credits', 'full project credits'],
      ['stack',    'the tech stack'],
      ['log',      'recent commit history'],
      ['thanks',   'special thanks'],
      ['note',     'a short note'],
      ['fortune', 'a random line I actually mean'],
      ['coffee',   'the real dependency'],
      ['stats',    'numbers, mostly true'],
      ['history', 'what you\'ve typed this session'],
      ['art',      'because why not'],
      ['clear',    'clear the terminal'],
      ['ls',       'list available files']
    ].forEach(function (row) {
      appendHTML('  <span class="term-key">' + row[0] + '</span>' +
        Array(11 - row[0].length).join(' ') + row[1], 'out');
    });
    appendSpacer();
  }

  function renderLs() {
    appendLine('credits.txt   stack.json   commits.log   thanks.txt   note.txt   avatar.jpg', 'out');
    appendSpacer();
  }

  var FORTUNES = [
    'good code is a message to whoever reads it next — including future you.',
    'every bug is an edge case you didn\'t plan for but still have to resolve.',
    'ship it, then iterate. iterating first has never shipped anything.',
    'the best comment is the one the code no longer needed.',
    'good design and good engineering start the same way: a blank canvas and a clear intent.',
    'naming things is hard because it forces you to admit what the thing actually does.',
    'a clean git history is a record you\'re willing to hand someone else.',
    'the deadline moves. the standards don\'t have to.',
    'most "quick fixes" are just future refactors wearing a disguise.',
    'the details no one asks about are usually the ones that matter most.'
  ];
  function renderFortune() {
    var pick = FORTUNES[Math.floor(Math.random() * FORTUNES.length)];
    appendLine('fortune', 'heading');
    appendLine('  "' + pick + '"', 'accent');
    appendSpacer();
  }

  function renderCoffee() {
    var cup = [
      '      ( (',
      '       ) )',
      '    ........',
      '    |      |]',
      '    \\      /',
      '     `-----\''
    ];
    cup.forEach(function (l) { appendLine(l, 'dim'); });
    appendLine('brewing... this app runs on it as much as PostgreSQL does.', 'out');
    appendSpacer();
  }

  function renderStats() {
    appendLine('project stats:', 'heading');
    [
      ['commits so far',      '160+ and counting'],
      ['times the palette changed', '4 (ochre won)'],
      ['cups of coffee',      'immeasurable, genuinely'],
      ['bugs fixed at 1am',   'more than I\'d admit at 1pm'],
      ['favorite gem',        'turbo-rails, no contest']
    ].forEach(function (row) {
      appendHTML('  <span class="term-key">' + row[0] + ':</span>  ' + row[1], 'out');
    });
    appendSpacer();
  }

  function renderHistory() {
    if (!cmdHistory.length) {
      appendLine('no commands run yet — this session started clean.', 'dim');
    } else {
      cmdHistory.forEach(function (c, i) {
        appendLine('  ' + (i + 1) + '  ' + c, 'dim');
      });
    }
    appendSpacer();
  }

  var matrixActive = false;
  function renderMatrix() {
    if (skipRequested || matrixActive) {
      appendLine('wake up, visitor... just kidding. try `help`.', 'ok');
      appendSpacer();
      return Promise.resolve();
    }
    matrixActive = true;
    var chars = '01アイウエオカキクケコサシスセソ';
    var rows = 6;
    var cols = window.innerWidth < 480 ? 32 : 52;
    var lines = [];
    for (var r = 0; r < rows; r++) lines.push(appendLine('', 'ok'));

    return new Promise(function (resolve) {
      var ticks = 0;
      var iv = setInterval(function () {
        lines.forEach(function (el) {
          var s = '';
          for (var c = 0; c < cols; c++) s += chars.charAt(Math.floor(Math.random() * chars.length));
          el.textContent = s;
        });
        scrollDown();
        ticks++;
        if (ticks >= 14) {
          clearInterval(iv);
          lines.forEach(function (el) { el.remove(); });
          appendLine('...anyway. this is a Rails app, not a simulation. `help` for real commands.', 'ok');
          appendSpacer();
          matrixActive = false;
          resolve();
        }
      }, 65);
    });
  }

  function renderWhoami() {
    var card = [
      '┌─────────────────────────────────────────────────────────┐',
      '│ Saurabh Kumar                                      │',
      '│ software engineer · "Karta-Dharta" of this space   │',
      '├─────────────────────────────────────────────────────────┤',
      '│ role      Generation-Operation-Destruction         │',
      '│ stack     Chaku, Khanjar, Bandook, Bomb            │',
      '│ focus     maksad sirf ek hai.. PAISA               │',
      '│ status    Single                                   │',
      '└─────────────────────────────────────────────────────────┘'
    ];
    card.forEach(function (l) { appendLine(l, 'dim'); });
    appendSpacer();
    appendLine('built to give artists a considered place to catalog and exhibit their', 'out');
    appendLine('work — try `credits` or `fortune` to see more.', 'out');
    appendSpacer();
  }

  function downloadBar() {
    return new Promise(function (resolve) {
      var el = document.createElement('div');
      el.className = 'term-line out';
      body.appendChild(el);
      if (skipRequested) { el.textContent = '[####################] 100%  avatar.jpg'; resolve(); return; }
      var pct = 0;
      var iv = setInterval(function () {
        if (skipRequested) { clearInterval(iv); el.textContent = '[####################] 100%  avatar.jpg'; resolve(); return; }
        pct = Math.min(100, pct + Math.random() * 20 + 8);
        var filled = Math.round(pct / 5);
        el.textContent = '[' + repeatChar('#', filled) + repeatChar('-', 20 - filled) + '] ' + Math.floor(pct) + '%  avatar.jpg';
        scrollDown();
        if (pct >= 100) { clearInterval(iv); resolve(); }
      }, 110);
    });
  }

  function repeatChar(ch, n) {
    var s = '';
    for (var i = 0; i < n; i++) s += ch;
    return s;
  }

  function loadPhotoImage() {
    if (!photoImagePromise) {
      photoImagePromise = new Promise(function (resolve, reject) {
        var img = new Image();
        img.onload = function () { resolve(img); };
        img.onerror = function () { reject(new Error('not found')); };
        img.src = PHOTO_URL;
      });
    }
    return photoImagePromise;
  }

  function toneColor(lum) {
    var r = Math.round(lerp(90, 240, lum));
    var g = Math.round(lerp(80, 230, lum));
    var b = Math.round(lerp(64, 211, lum));
    return 'rgb(' + r + ',' + g + ',' + b + ')';
  }

  function imageToAsciiHTML(img) {
    var cols = window.innerWidth < 480 ? 46 : 72;
    var charAspect = 0.52;
    var rows = Math.max(1, Math.round(cols * (img.naturalHeight / img.naturalWidth) * charAspect));

    var canvas = document.createElement('canvas');
    canvas.width = cols;
    canvas.height = rows;
    var ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, cols, rows);
    var data = ctx.getImageData(0, 0, cols, rows).data;

    var ramp = ' .:-=+*#%@';
    var html = '';
    for (var y = 0; y < rows; y++) {
      for (var x = 0; x < cols; x++) {
        var i = (y * cols + x) * 4;
        var lum = (0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2]) / 255;
        var ch = ramp[Math.min(ramp.length - 1, Math.floor(lum * ramp.length))];
        html += '<span style="color:' + toneColor(lum) + '">' + (ch === ' ' ? '&nbsp;' : ch) + '</span>';
      }
      html += '\n';
    }
    return html;
  }

  function renderPhoto() {
    return typeLine('curl -O https://the-studio.local/avatar.jpg', 'cmd')
      .then(function () { return downloadBar(); })
      .then(function () { appendLine('rendering ascii preview…', 'dim'); return loadPhotoImage(); })
      .then(function (img) {
        var pre = document.createElement('div');
        pre.className = 'term-line ascii-photo';
        pre.innerHTML = imageToAsciiHTML(img);
        body.appendChild(pre);
        scrollDown();
        appendLine("type `develop` to see it at full resolution", 'dim');
        appendSpacer();
      })
      .catch(function () {
        appendLine('avatar.jpg not found — drop it in public/images/credits-avatar.jpg', 'err');
        appendSpacer();
      });
  }

  function renderDevelop() {
    return loadPhotoImage().then(function () {
      var wrap = document.createElement('div');
      wrap.className = 'term-line out';
      wrap.innerHTML =
        '<div class="photo-frame">' +
          '<img src="' + PHOTO_URL + '" alt="Photo of Saurabh Kumar">' +
        '</div>' +
        '<div class="photo-caption">developed in the darkroom, 1/500s</div>';
      body.appendChild(wrap);
      scrollDown();
      requestAnimationFrame(function () {
        var img = wrap.querySelector('img');
        if (skipRequested) { img.classList.add('revealed'); return; }
        requestAnimationFrame(function () { img.classList.add('revealed'); });
      });
      appendSpacer();
    }).catch(function () {
      appendLine('nothing to develop — try `photo` first', 'err');
      appendSpacer();
    });
  }

  var ALIASES = {
    'whoami': renderWhoami,
    'credits': renderCredits, 'cat credits.txt': renderCredits,
    'stack': renderStack, 'cat stack.json': renderStack,
    'log': renderLog, 'git log': renderLog, 'commits': renderLog,
    'thanks': renderThanks, 'cat thanks.txt': renderThanks,
    'note': renderNote, 'cat note.txt': renderNote, 'read letter': renderNote,
    'art': renderArt, 'ascii': renderArt,
    'help': renderHelp, '?': renderHelp,
    'ls': renderLs,
    'fortune': renderFortune,
    'coffee': renderCoffee,
    'stats': renderStats,
    'history': renderHistory
  };

  var ASYNC_ALIASES = {
    'photo': renderPhoto, 'cat avatar.jpg': renderPhoto, 'whoami --photo': renderPhoto,
    'develop': renderDevelop, 'reveal': renderDevelop,
    'matrix': renderMatrix
  };

  function runCommand(raw) {
    var cmd = raw.trim().toLowerCase();
    if (!cmd) return Promise.resolve();

    cmdHistory.push(raw.trim());
    historyPos = cmdHistory.length;

    appendLine(raw.trim(), 'cmd');

    if (cmd === 'clear' || cmd === 'cls') {
      body.innerHTML = '';
      return Promise.resolve();
    }
    if (cmd === 'exit' || cmd === 'logout' || cmd === 'quit') {
      appendLine('you can check out any time you like — there is nowhere else to go.', 'dim');
      appendSpacer();
      return Promise.resolve();
    }
    if (cmd.indexOf('sudo') === 0) {
      appendLine('nice try. this studio runs on trust, not root access.', 'err');
      appendSpacer();
      return Promise.resolve();
    }
    if (ASYNC_ALIASES[cmd]) {
      return ASYNC_ALIASES[cmd]();
    }
    if (ALIASES[cmd]) {
      ALIASES[cmd]();
      return Promise.resolve();
    }
    appendLine('command not found: ' + raw.trim() + ' — try `help`', 'err');
    appendSpacer();
    return Promise.resolve();
  }

  function boot() {
    queueTyped('whoami', 'cmd');
    queue = queue.then(function () { renderWhoami(); });
    queueTyped('ls', 'cmd');
    queue = queue.then(function () { renderLs(); });
    queueTyped('# type `help` to explore — try `fortune`, or use ↑ / tab like a real shell', 'dim');
    queue.then(function () { input.focus({ preventScroll: true }); });
  }

  skipBtn.addEventListener('click', function () {
    skipRequested = true;
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      var val = input.value;
      input.value = '';
      queue = queue.then(function () { return runCommand(val); });
      return;
    }

    if (e.key === 'ArrowUp') {
      if (!cmdHistory.length) return;
      e.preventDefault();
      historyPos = Math.max(0, historyPos - 1);
      input.value = cmdHistory[historyPos] || '';
      requestAnimationFrame(function () { input.setSelectionRange(input.value.length, input.value.length); });
      return;
    }

    if (e.key === 'ArrowDown') {
      if (!cmdHistory.length) return;
      e.preventDefault();
      historyPos = Math.min(cmdHistory.length, historyPos + 1);
      input.value = cmdHistory[historyPos] || '';
      return;
    }

    if (e.key === 'Tab') {
      e.preventDefault();
      var partial = input.value.trim().toLowerCase();
      if (!partial) return;
      var matches = ALL_COMMANDS.filter(function (c) { return c.indexOf(partial) === 0; });
      if (matches.length === 1) {
        input.value = matches[0];
      } else if (matches.length > 1) {
        queue = queue.then(function () {
          appendLine(input.value, 'cmd');
          appendLine(matches.join('   '), 'dim');
          appendSpacer();
        });
      }
      return;
    }
  });

  boot();
})();

