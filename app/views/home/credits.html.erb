(function () {
  var frame = document.getElementById('live-preview-iframe');
  var loading = document.getElementById('live-preview-loading');
  var fallback = document.getElementById('live-preview-fallback');
  if (!frame) return;

  function checkLoadStatus() {
    // Check the data attribute flag set inline on the HTML element
    if (frame.dataset.loaded === 'true') {
      if (loading) loading.style.display = 'none';
      if (fallback) fallback.style.display = 'none';
      frame.style.display = 'block';
      return true;
    }
    return false;
  }

  // If it hasn't loaded yet, attach the listener
  if (!checkLoadStatus()) {
    frame.addEventListener('load', function () {
      frame.dataset.loaded = 'true';
      checkLoadStatus();
    });

    // Fallback timeout
    setTimeout(function () {
      if (!checkLoadStatus()) {
        if (loading) loading.style.display = 'none';
        if (fallback) fallback.style.display = 'flex';
        frame.style.display = 'none'; // Hide the broken frame completely
      }
    }, 12000);
  }
})();
</script>