<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #0d0b0a; margin: 0; padding: 40px 20px; color: #f5f1e8; }
    .container { max-width: 540px; margin: 0 auto; background: #161310; border: 1px solid #2a2622; border-radius: 8px; overflow: hidden; }
    .header { padding: 30px; text-align: center; border-bottom: 1px solid #2a2622; }
    .header h1 { font-family: "Georgia", serif; font-size: 24px; font-style: italic; color: #c4933f; margin: 0; font-weight: normal; }
    .content { padding: 40px 30px; }
    .meta { background: #110f0c; padding: 20px; border-radius: 6px; border: 1px solid #2a2622; margin-bottom: 30px; }
    .meta p { margin: 8px 0; font-size: 14px; color: #a49a8c; }
    .meta strong { color: #f5f1e8; font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; display: inline-block; width: 80px; }
    .meta a { color: #c4933f; text-decoration: none; }
    .message-label { font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: #a49a8c; margin-bottom: 15px; }
    .message { font-family: "Georgia", serif; font-size: 16px; color: #e8e4db; line-height: 1.8; white-space: pre-wrap; padding-left: 20px; border-left: 2px solid #c4933f; }
    .footer { padding: 20px 30px 30px; text-align: center; }
    .btn { display: inline-block; padding: 14px 28px; background-color: #c4933f; color: #000000; text-decoration: none; border-radius: 4px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>New Studio Enquiry</h1>
    </div>
    
    <div class="content">
      <div class="meta">
        <p><strong>From:</strong> <%= @enquiry.sender_name %> (<a href="mailto:<%= @enquiry.sender_email %>"><%= @enquiry.sender_email %></a>)</p>
        <% if @enquiry.artwork %>
          <p><strong>Artwork:</strong> <%= @enquiry.artwork.title %></p>
        <% end %>
        <p><strong>Date:</strong> <%= @enquiry.created_at.strftime("%B %d, %Y") %></p>
      </div>
      
      <p class="message-label">Message</p>
      <div class="message"><%= @enquiry.message %></div>
    </div>
    
    <div class="footer">
      <a href="<%= enquiries_url %>" class="btn">View in Dashboard</a>
    </div>
  </div>
</body>
</html>
